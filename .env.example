# ── ProSellerOS Copilot — environment ───────────────────────────────────────
# Copy to .env.local and fill in. .env.local is gitignored.
# If NONE of these are set, the app still runs fully on mock data (demo-safe).

# ── Which LLM backend runs the agent (chat + embeddings) ────────────────────
# "bedrock" = Claude + Titan on AWS.  "gemini" = Gemini + gemini-embedding-001.
# Both run the identical agent loop and tool set; only this line changes.
# Leave blank to auto-detect (prefers Bedrock whenever AWS credentials exist —
# including the Amplify execution role — so set it explicitly to force Gemini).
# Use gemini if your AWS account has no Bedrock on-demand model quota.
AI_PROVIDER=gemini

# ── CockroachDB (persistent memory + vector layer) ──────────────────────────
# From: ccloud cluster create  →  Connect  →  "General connection string".
# Looks like: postgresql://user:pass@host:26257/proselleros?sslmode=verify-full
COCKROACH_DSN=

# ── AWS (agent execution: Bedrock + S3) ─────────────────────────────────────
AWS_REGION=ap-southeast-2
# Standard AWS credential chain is used (env vars, shared config, or IAM role
# when running on Lambda/Amplify). For local dev set these two:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock model IDs (enable model access in the Bedrock console first).
# In ap-southeast-2, Claude must be called via its APAC cross-region inference
# profile (raw model IDs return "Operation not allowed"). Titan embeds direct.
BEDROCK_CHAT_MODEL_ID=apac.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# Titan v2 supports 256 / 512 / 1024 dims. Must match db/schema.sql VECTOR size.
EMBED_DIMS=1024

# S3 bucket for exported reports and generated listing assets.
S3_BUCKET=

# ── Google Gemini (Hackathon B: >=1 Gemini LLM call in the deployed app) ─────
# Two auth modes — pick one:
#   Vertex AI (recommended for Hackathon B — real Google Cloud product, bills to
#     your GCP credits): GEMINI_USE_VERTEX=true + GOOGLE_CLOUD_PROJECT, and auth
#     via ADC (`gcloud auth application-default login`). No API key needed.
#   Developer API: leave GEMINI_USE_VERTEX blank and set GEMINI_API_KEY from
#     Google AI Studio (aistudio.google.com). Free tier; does not use GCP credits.
GEMINI_USE_VERTEX=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_API_KEY=
# In Vertex AI, use a 2.5-series model (the gemini-2.0-flash alias is not served).
GEMINI_MODEL_ID=gemini-2.5-flash
# Embedding model used when AI_PROVIDER=gemini. Supports flexible output dims
# (128-3072), so EMBED_DIMS=1024 matches db/schema.sql with no schema change.
GEMINI_EMBED_MODEL_ID=gemini-embedding-001
